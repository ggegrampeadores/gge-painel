<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel do Operador - Controle Total GGE</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="config.js"></script>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:#0d1117; color:#e6edf3; }
    .main-with-sidebar { margin-left:48px; min-height:100vh; padding:24px; }

    /* Tabs */
    .tabs { display:flex; gap:0; border-bottom:1px solid #30363d; margin-bottom:24px; }
    .tab { padding:12px 24px; cursor:pointer; color:#8b949e; font-size:14px; font-weight:500; border-bottom:2px solid transparent; transition:all .2s; }
    .tab:hover { color:#c9d1d9; }
    .tab.active { color:#58a6ff; border-bottom-color:#58a6ff; }
    .tab-badge { display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:20px; padding:0 6px; border-radius:10px; font-size:11px; font-weight:700; margin-left:8px; }
    .tab-badge.red { background:#f8514922; color:#f85149; }
    .tab-badge.yellow { background:#d2992222; color:#d29922; }
    .tab-badge.blue { background:#58a6ff22; color:#58a6ff; }
    .tab-content { display:none; }
    .tab-content.active { display:block; }

    /* Header com score de saúde */
    .header-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:16px; }
    .header-title { font-size:22px; font-weight:700; color:#e6edf3; }
    .header-sub { font-size:13px; color:#8b949e; margin-top:4px; }
    .health-cards { display:flex; gap:12px; flex-wrap:wrap; }
    .health-card { background:#161b22; border:1px solid #30363d; border-radius:10px; padding:12px 20px; min-width:160px; text-align:center; }
    .health-card-name { font-size:11px; color:#8b949e; text-transform:uppercase; letter-spacing:.5px; margin-bottom:4px; }
    .health-card-score { font-size:28px; font-weight:800; }
    .health-card-score.green { color:#3fb950; }
    .health-card-score.yellow { color:#d29922; }
    .health-card-score.orange { color:#e3842a; }
    .health-card-score.red { color:#f85149; }
    .health-card-detail { font-size:11px; color:#8b949e; margin-top:2px; }

    /* Refresh */
    .btn-refresh { background:#21262d; border:1px solid #30363d; color:#c9d1d9; padding:8px 16px; border-radius:6px; cursor:pointer; font-size:13px; display:flex; align-items:center; gap:6px; transition:all .2s; }
    .btn-refresh:hover { background:#30363d; border-color:#58a6ff; }
    .btn-refresh.loading svg { animation:spin 1s linear infinite; }
    @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

    /* Top 10 */
    .top10-section { margin-bottom:32px; }
    .top10-title { font-size:16px; font-weight:600; color:#e6edf3; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
    .top10-title svg { color:#d29922; }
    .top10-list { display:flex; flex-direction:column; gap:6px; }
    .top10-item { display:flex; align-items:center; gap:12px; padding:12px 16px; background:#161b22; border:1px solid #30363d; border-radius:8px; transition:all .2s; cursor:default; }
    .top10-item:hover { border-color:#484f58; }
    .top10-rank { width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; }
    .top10-rank.p1 { background:#f8514933; color:#f85149; }
    .top10-rank.p2 { background:#e3842a33; color:#e3842a; }
    .top10-rank.p3 { background:#d2992233; color:#d29922; }
    .top10-rank.p4 { background:#58a6ff22; color:#58a6ff; }
    .top10-icon { flex-shrink:0; width:20px; height:20px; }
    .top10-text { flex:1; }
    .top10-text-main { font-size:14px; color:#e6edf3; }
    .top10-text-detail { font-size:12px; color:#8b949e; margin-top:2px; }
    .top10-days { font-size:11px; color:#8b949e; background:#21262d; padding:3px 8px; border-radius:4px; white-space:nowrap; }
    .top10-actions { display:flex; gap:4px; }

    /* Alert Groups */
    .alert-groups { display:flex; flex-direction:column; gap:16px; }
    .alert-group { background:#161b22; border:1px solid #30363d; border-radius:10px; overflow:hidden; }
    .alert-group-header { display:flex; align-items:center; gap:12px; padding:14px 18px; cursor:pointer; transition:all .2s; }
    .alert-group-header:hover { background:#1c2129; }
    .alert-group-icon { width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .alert-group-icon.critical { background:#f8514922; color:#f85149; }
    .alert-group-icon.warning { background:#d2992222; color:#d29922; }
    .alert-group-icon.info { background:#58a6ff22; color:#58a6ff; }
    .alert-group-icon.success { background:#3fb95022; color:#3fb950; }
    .alert-group-title { flex:1; }
    .alert-group-title h3 { font-size:14px; font-weight:600; color:#e6edf3; }
    .alert-group-title p { font-size:12px; color:#8b949e; margin-top:2px; }
    .alert-group-count { font-size:20px; font-weight:800; min-width:40px; text-align:center; }
    .alert-group-count.zero { color:#3fb950; }
    .alert-group-count.nonzero { color:#f85149; }
    .alert-group-count.warn { color:#d29922; }
    .alert-group-chevron { color:#484f58; transition:transform .2s; }
    .alert-group-chevron.open { transform:rotate(180deg); }
    .alert-group-body { display:none; border-top:1px solid #30363d; padding:16px 18px; max-height:400px; overflow-y:auto; }
    .alert-group-body.open { display:block; }

    /* Alert items dentro do grupo */
    .alert-item { display:flex; align-items:center; gap:12px; padding:8px 12px; border-radius:6px; font-size:13px; color:#c9d1d9; transition:all .15s; }
    .alert-item:hover { background:#21262d; }
    .alert-item-text { flex:1; }
    .alert-item-tag { font-size:11px; padding:2px 8px; border-radius:4px; background:#21262d; color:#8b949e; }
    .alert-item a { color:#58a6ff; text-decoration:none; }
    .alert-item a:hover { text-decoration:underline; }

    /* Botões de ação nos alertas */
    .alert-btn { border:none; padding:4px 10px; border-radius:4px; font-size:11px; cursor:pointer; transition:all .15s; font-weight:500; }
    .alert-btn-snooze { background:#21262d; color:#d29922; border:1px solid #30363d; }
    .alert-btn-snooze:hover { background:#2d2200; border-color:#d29922; }
    .alert-btn-resolve { background:#21262d; color:#3fb950; border:1px solid #30363d; }
    .alert-btn-resolve:hover { background:#0d2818; border-color:#3fb950; }
    .alert-btn-off { background:#21262d; color:#8b949e; border:1px solid #30363d; }
    .alert-btn-off:hover { background:#1c1c1c; border-color:#8b949e; }

    /* Snooze dropdown */
    .snooze-menu { position:absolute; background:#161b22; border:1px solid #30363d; border-radius:6px; padding:4px; z-index:100; box-shadow:0 4px 12px rgba(0,0,0,.4); }
    .snooze-option { display:block; width:100%; text-align:left; padding:6px 12px; border:none; background:none; color:#c9d1d9; font-size:12px; border-radius:4px; cursor:pointer; }
    .snooze-option:hover { background:#21262d; }

    /* Empty state */
    .empty-state { text-align:center; padding:48px 24px; color:#8b949e; }
    .empty-state svg { margin-bottom:16px; color:#3fb950; }
    .empty-state h3 { color:#3fb950; font-size:18px; margin-bottom:8px; }

    /* Aba Devoluções */
    .devol-table { width:100%; border-collapse:collapse; }
    .devol-table th { text-align:left; padding:10px 12px; font-size:12px; color:#8b949e; border-bottom:1px solid #30363d; font-weight:600; text-transform:uppercase; letter-spacing:.5px; }
    .devol-table td { padding:10px 12px; font-size:13px; border-bottom:1px solid #21262d; }
    .devol-status { display:inline-block; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:600; }
    .devol-status.integro { background:#3fb95022; color:#3fb950; }
    .devol-status.danificado { background:#d2992222; color:#d29922; }
    .devol-status.destruido { background:#f8514922; color:#f85149; }
    .devol-status.pendente { background:#58a6ff22; color:#58a6ff; }

    /* Loading */
    .loading-overlay { display:flex; align-items:center; justify-content:center; padding:48px; }
    .loading-spinner { width:32px; height:32px; border:3px solid #30363d; border-top-color:#58a6ff; border-radius:50%; animation:spin .8s linear infinite; }

    /* Conta tag */
    .conta-tag { font-size:11px; padding:2px 6px; border-radius:3px; font-weight:600; }
    .conta-tag.gge { background:#1a3a5c; color:#58a6ff; }
    .conta-tag.toow { background:#2d1b00; color:#d29922; }
    .conta-tag.ggesp { background:#0d2818; color:#3fb950; }

    /* Responsivo */
    @media (max-width:768px) {
      .main-with-sidebar { margin-left:0; padding:16px; }
      .health-cards { flex-direction:column; }
      .header-row { flex-direction:column; align-items:flex-start; }
    }
  </style>
</head>
<body>
  <div id="sidebar-container"></div>
  <div class="main-with-sidebar">

    <!-- Header -->
    <div class="header-row">
      <div>
        <div class="header-title">Painel do Operador</div>
        <div class="header-sub">Alertas e pendências operacionais — resolva, adie ou desligue</div>
      </div>
      <div style="display:flex;align-items:center;gap:12px;">
        <button class="btn-refresh" id="btnRefresh" onclick="carregarTudo()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
          Atualizar
        </button>
      </div>
    </div>

    <!-- Score de saúde por conta -->
    <div class="health-cards" id="healthCards">
      <div class="health-card"><div class="loading-spinner" style="margin:8px auto;width:20px;height:20px;"></div></div>
    </div>

    <!-- Tabs -->
    <div class="tabs" style="margin-top:24px;">
      <div class="tab active" data-tab="alertas" onclick="trocarTab(this)">
        Alertas <span class="tab-badge red" id="badgeAlertas">...</span>
      </div>
      <div class="tab" data-tab="devolucoes" onclick="trocarTab(this)">
        Devoluções <span class="tab-badge yellow" id="badgeDevolucoes">0</span>
      </div>
    </div>

    <!-- Tab: Alertas -->
    <div class="tab-content active" id="tab-alertas">
      <!-- Top 10 do Dia -->
      <div class="top10-section">
        <div class="top10-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Top 10 do Dia
        </div>
        <div class="top10-list" id="top10List">
          <div class="loading-overlay"><div class="loading-spinner"></div></div>
        </div>
      </div>

      <!-- Grupos de alertas -->
      <div style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e6edf3;">Todos os Alertas</div>
      <div class="alert-groups" id="alertGroups">
        <div class="loading-overlay"><div class="loading-spinner"></div></div>
      </div>
    </div>

    <!-- Tab: Devoluções -->
    <div class="tab-content" id="tab-devolucoes">
      <div id="devolucoesContent">
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <h3>Controle de devoluções</h3>
          <p>Registros de devoluções aparecerão aqui conforme forem cadastrados.<br>Acompanhe condição de retorno, pedidos de estorno e reintegração ao estoque.</p>
        </div>
      </div>
    </div>

  </div>

  <script src="sidebar.js" defer></script>
  <script>
  (function() {
    var auth = sessionStorage.getItem('gge_auth');
    if (auth !== 'gge2026') { window.location.href = '/'; return; }
  })();

  var sb = supabase.createClient(window.GGE_SUPABASE_URL, window.GGE_SUPABASE_KEY);

  // ═══════════════════════════════════════════════════════════
  // CONFIGURAÇÃO DOS ALERTAS
  // ═══════════════════════════════════════════════════════════

  var CONTAS_MAP = {};  // preenchido no load

  // Definição de cada tipo de alerta
  // prioridade: 1=crítico/cliente, 2=reputação, 3=financeiro, 4=cadastral
  var ALERT_DEFS = [
    {
      tipo: 'claim_aberto',
      titulo: 'Reclamações abertas',
      descricao: 'Claims ML aguardando resposta',
      categoria: 'cliente',
      prioridade: 1,
      icone: 'critical',
      query: async function() {
        var { data } = await sb.from('claims').select('id, mlb_id, conta_id, status, data_abertura, motivo').eq('status','opened');
        return (data || []).map(function(c) {
          return { ref: c.id, texto: c.motivo || 'Reclamação aberta', detalhe: c.mlb_id, conta_id: c.conta_id, data: c.data_abertura };
        });
      }
    },
    {
      tipo: 'envio_atrasado',
      titulo: 'Vendas com envio pendente',
      descricao: 'Vendas pagas há mais de 48h sem envio confirmado',
      categoria: 'cliente',
      prioridade: 1,
      icone: 'critical',
      query: async function() {
        var { data: rows } = await sb.from('vendas')
          .select('ordem_id, mlb_id, conta_id, data_venda, preco_total')
          .eq('status', 'paid')
          .lt('data_venda', new Date(Date.now() - 48*60*60*1000).toISOString())
          .gt('data_venda', new Date(Date.now() - 30*24*60*60*1000).toISOString())
          .limit(50);
        if (!rows || !rows.length) return [];
        // Filtrar os que não têm envio confirmado
        var orderIds = rows.map(function(r) { return r.ordem_id; });
        var { data: envios } = await sb.from('envios').select('ordem_id, status').in('ordem_id', orderIds);
        var envioMap = {};
        (envios || []).forEach(function(e) { envioMap[e.ordem_id] = e.status; });
        return rows.filter(function(r) {
          var st = envioMap[r.ordem_id];
          return !st || (st !== 'delivered' && st !== 'shipped' && st !== 'ready_to_ship');
        }).map(function(r) {
          var dias = Math.floor((Date.now() - new Date(r.data_venda).getTime()) / 86400000);
          return { ref: r.ordem_id, texto: 'Venda há ' + dias + ' dias sem envio', detalhe: r.mlb_id + ' — R$ ' + (r.preco_total||0).toFixed(2), conta_id: r.conta_id, data: r.data_venda };
        });
      }
    },
    {
      tipo: 'reputacao_risco',
      titulo: 'Reputação em risco',
      descricao: 'Conta com indicador de reputação degradando',
      categoria: 'reputacao',
      prioridade: 2,
      icone: 'warning',
      query: async function() {
        var { data } = await sb.from('reputacao_conta')
          .select('conta_id, nivel_cor, taxa_reclamacoes, taxa_atraso_envio, data_referencia')
          .order('data_referencia', { ascending: false })
          .limit(10);
        if (!data) return [];
        // Pegar última de cada conta
        var seen = {};
        var alertas = [];
        data.forEach(function(r) {
          if (seen[r.conta_id]) return;
          seen[r.conta_id] = true;
          var problemas = [];
          if (r.taxa_reclamacoes > 0.01) problemas.push('Reclamações: ' + (r.taxa_reclamacoes * 100).toFixed(1) + '%');
          if (r.taxa_atraso_envio > 0.02) problemas.push('Atrasos: ' + (r.taxa_atraso_envio * 100).toFixed(1) + '%');
          if (r.nivel_cor && !r.nivel_cor.includes('green')) problemas.push('Nível: ' + r.nivel_cor);
          if (problemas.length > 0) {
            alertas.push({ ref: r.conta_id, texto: problemas.join(' | '), detalhe: '', conta_id: r.conta_id, data: r.data_referencia });
          }
        });
        return alertas;
      }
    },
    {
      tipo: 'flex_atrasado',
      titulo: 'Entregas Flex atrasadas',
      descricao: 'Envios Flex entregues fora do prazo nos últimos 30 dias',
      categoria: 'reputacao',
      prioridade: 2,
      icone: 'warning',
      query: async function() {
        var { data } = await sb.from('envios')
          .select('shipment_id, ordem_id, data_envio, data_entrega, tipo_logistica, entregue_no_prazo')
          .eq('tipo_logistica', 'self_service')
          .eq('entregue_no_prazo', false)
          .gt('data_envio', new Date(Date.now() - 30*24*60*60*1000).toISOString())
          .limit(50);
        return (data || []).map(function(e) {
          return { ref: e.shipment_id, texto: 'Flex entregue fora do prazo', detalhe: 'Envio ' + e.shipment_id, conta_id: null, data: e.data_envio };
        });
      }
    },
    {
      tipo: 'mc_negativa',
      titulo: 'Anúncios com MC negativa',
      descricao: 'Anúncios ativos com margem negativa nos últimos 60 dias',
      categoria: 'financeiro',
      prioridade: 3,
      icone: 'warning',
      query: async function() {
        var { data } = await sb.from('vw_mc_por_anuncio')
          .select('mlb_id, conta_id, titulo, mc_sem_ads, receita, custo_produto, comissao, custo_frete, qtd_ordens, conta_nome')
          .eq('tem_custo', true)
          .lt('mc_sem_ads', 0)
          .gte('mes', new Date(Date.now() - 60*24*60*60*1000).toISOString().slice(0,7) + '-01')
          .order('mc_sem_ads', { ascending: true })
          .limit(100);
        return (data || []).map(function(m) {
          return { ref: m.mlb_id, texto: m.titulo || m.mlb_id, detalhe: 'MC: R$ ' + (m.mc_sem_ads||0).toFixed(2) + ' | ' + (m.qtd_ordens||0) + ' vendas | ' + (m.conta_nome||''), conta_id: m.conta_id, data: null };
        });
      }
    },
    {
      tipo: 'pausado_com_demanda',
      titulo: 'Pausados com demanda recente',
      descricao: 'Anúncios pausados que tiveram vendas nos últimos 60 dias',
      categoria: 'financeiro',
      prioridade: 3,
      icone: 'warning',
      query: async function() {
        // Buscar anúncios pausados
        var { data: pausados } = await sb.from('anuncios')
          .select('mlb_id, titulo, conta_id, sku_vendedor')
          .eq('status', 'paused')
          .limit(200);
        if (!pausados || !pausados.length) return [];
        var mlbs = pausados.map(function(p) { return p.mlb_id; });
        // Buscar vendas recentes desses MLBs
        var { data: vendas } = await sb.from('vendas')
          .select('mlb_id, ordem_id')
          .in('mlb_id', mlbs)
          .gte('data_venda', new Date(Date.now() - 60*24*60*60*1000).toISOString())
          .eq('status', 'paid');
        var mlbsComVenda = {};
        (vendas || []).forEach(function(v) {
          mlbsComVenda[v.mlb_id] = (mlbsComVenda[v.mlb_id] || 0) + 1;
        });
        return pausados.filter(function(p) { return mlbsComVenda[p.mlb_id]; }).map(function(p) {
          return { ref: p.mlb_id, texto: p.titulo || p.mlb_id, detalhe: mlbsComVenda[p.mlb_id] + ' vendas nos últimos 60d', conta_id: p.conta_id, data: null };
        });
      }
    },
    {
      tipo: 'sem_custo',
      titulo: 'SKUs ativos sem preço de custo',
      descricao: 'Anúncios ativos cujo SKU não tem custo CIF cadastrado',
      categoria: 'cadastral',
      prioridade: 4,
      icone: 'info',
      query: async function() {
        var skuData = await carregarSkusCadastro();
        var { data: anuncios } = await sb.from('anuncios')
          .select('mlb_id, titulo, sku_vendedor, conta_id')
          .eq('status', 'active')
          .not('sku_vendedor', 'is', null)
          .neq('sku_vendedor', '');
        return (anuncios || []).filter(function(a) {
          var s = skuData[a.sku_vendedor];
          return s && (!s.custo_cif_rj || s.custo_cif_rj === 0) && (!s.custo_cif_sp || s.custo_cif_sp === 0);
        }).map(function(a) {
          return { ref: a.sku_vendedor, texto: a.titulo || a.mlb_id, detalhe: 'SKU: ' + a.sku_vendedor, conta_id: a.conta_id, data: null };
        });
      }
    },
    {
      tipo: 'sem_peso',
      titulo: 'SKUs ativos sem peso',
      descricao: 'Produtos ativos sem peso cadastrado — frete calculado incorretamente',
      categoria: 'cadastral',
      prioridade: 4,
      icone: 'info',
      query: async function() {
        var skuData = await carregarSkusCadastro();
        var { data: anuncios } = await sb.from('anuncios')
          .select('mlb_id, titulo, sku_vendedor, conta_id')
          .eq('status', 'active')
          .not('sku_vendedor', 'is', null)
          .neq('sku_vendedor', '');
        return (anuncios || []).filter(function(a) {
          var s = skuData[a.sku_vendedor];
          return s && (!s.peso || s.peso === 0);
        }).map(function(a) {
          var s = skuData[a.sku_vendedor];
