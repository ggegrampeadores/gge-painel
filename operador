  function esc(s) { if (!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

  function toggleGroup(header) {
    var body = header.nextElementSibling;
    var chevron = header.querySelector('.alert-group-chevron');
    body.classList.toggle('open');
    chevron.classList.toggle('open');
  }

  function trocarTab(el) {
    document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
    el.classList.add('active');
    document.getElementById('tab-' + el.dataset.tab).classList.add('active');
  }

  window.mostrarSnooze = function(event, tipo, ref) {
    // Fechar menus abertos
    document.querySelectorAll('.snooze-menu').forEach(function(m) { m.remove(); });
    var menu = document.createElement('div');
    menu.className = 'snooze-menu';
    menu.innerHTML =
      '<button class="snooze-option" onclick="executarAcao(\'' + tipo + '\',\'' + ref + '\',\'snooze\',3)">3 dias</button>' +
      '<button class="snooze-option" onclick="executarAcao(\'' + tipo + '\',\'' + ref + '\',\'snooze\',7)">7 dias</button>' +
      '<button class="snooze-option" onclick="executarAcao(\'' + tipo + '\',\'' + ref + '\',\'snooze\',15)">15 dias</button>' +
      '<button class="snooze-option" onclick="executarAcao(\'' + tipo + '\',\'' + ref + '\',\'snooze\',30)">30 dias</button>';
    menu.style.position = 'fixed';
    menu.style.left = event.clientX + 'px';
    menu.style.top = event.clientY + 'px';
    document.body.appendChild(menu);
    // Fechar ao clicar fora
    setTimeout(function() {
      document.addEventListener('click', function handler() {
        menu.remove();
        document.removeEventListener('click', handler);
      });
    }, 10);
  };

  // ═══════════════════════════════════════════════════════════
  // CARREGAR TUDO
  // ═══════════════════════════════════════════════════════════

  window.carregarTudo = async function() {
    var btn = document.getElementById('btnRefresh');
    btn.classList.add('loading');

    try {
      _skuCache = null; // limpar cache de SKUs
      await carregarContas();
      await carregarAcoes();

      // Executar todas as queries de alertas
      var promises = ALERT_DEFS.map(async function(def) {
        try {
          var items = await def.query();
          alertasCarregados[def.tipo] = items;
        } catch(e) {
          console.error('Erro ao carregar ' + def.tipo, e);
          alertasCarregados[def.tipo] = [];
        }
      });
      await Promise.all(promises);

      // Montar lista unificada para Top 10
      var todosAlertas = [];
      var alertasPorConta = {};
      ALERT_DEFS.forEach(function(def) {
        var items = filtrarAtivos(def.tipo, alertasCarregados[def.tipo] || []);
        items.forEach(function(item) {
          item.tipo = def.tipo;
          item.prioridade = def.prioridade;
          todosAlertas.push(item);
          if (item.conta_id) {
            alertasPorConta[item.conta_id] = (alertasPorConta[item.conta_id] || 0) + 1;
          }
        });
      });

      renderHealthCards(alertasPorConta);
      renderTop10(todosAlertas);
      renderAlertGroups();

      // Carregar devoluções
      carregarDevolucoes();

    } catch(e) {
      console.error('Erro geral:', e);
    } finally {
      btn.classList.remove('loading');
    }
  };

  // ═══════════════════════════════════════════════════════════
  // ABA DEVOLUÇÕES
  // ═══════════════════════════════════════════════════════════

  async function carregarDevolucoes() {
    var resp = await sb.from('devolucoes_controle').select('*').order('criado_em', { ascending: false }).limit(50);
    var data = resp.data;
    if (!data || data.length === 0) {
      document.getElementById('badgeDevolucoes').textContent = '0';
      return;
    }
    var pendentes = data.filter(function(d) { return d.condicao_retorno === 'pendente' || (!d.estorno_solicitado && d.condicao_retorno === 'destruido'); });
    document.getElementById('badgeDevolucoes').textContent = pendentes.length;
    var tbl = '<table class="devol-table"><thead><tr><th>Ordem</th><th>MLB</th><th>Conta</th><th>Data</th><th>Condição</th><th>Estorno</th><th>Valor</th><th>Obs</th></tr></thead><tbody>';
    data.forEach(function(d) {
      tbl += '<tr><td>' + (d.ordem_id||'-') + '</td><td>' + (d.mlb_id||'-') + '</td><td>' + contaTag(d.conta_id) + '</td><td>' + (d.data_devolucao||'-') + '</td><td><span class="devol-status ' + (d.condicao_retorno||'pendente') + '">' + (d.condicao_retorno||'pendente') + '</span></td><td>' + (d.estorno_solicitado ? (d.estorno_aprovado ? 'Aprovado' : 'Solicitado') : '-') + '</td><td>' + (d.valor_estorno ? 'R$ '+d.valor_estorno.toFixed(2) : '-') + '</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + esc(d.observacao||'') + '">' + esc(d.observacao||'') + '</td></tr>';
    });
    tbl += '</tbody></table>';
    document.getElementById('devolucoesContent').innerHTML = tbl;
  }

  carregarTudo();
  window.executarAcao = executarAcao;
  window.toggleGroup = toggleGroup;
  window.trocarTab = trocarTab;

  </script>
</body>
</html>
