  function renderHealthCards(alertasPorConta) {
    var html = '';
    var contaIds = Object.keys(CONTAS_MAP);
    contaIds.forEach(function(cid) {
      var c = CONTAS_MAP[cid];
      var totalAlertas = alertasPorConta[cid] || 0;
      var score = Math.max(0, 100 - totalAlertas * 2);
      var cor = score >= 80 ? 'green' : score >= 60 ? 'yellow' : score >= 40 ? 'orange' : 'red';
      var nome = c.nome.replace('-GRAMPEADORES','').replace('COMERCIAL','');
      html += '<div class="health-card">' +
        '<div class="health-card-name">' + nome + '</div>' +
        '<div class="health-card-score ' + cor + '">' + score + '</div>' +
        '<div class="health-card-detail">' + totalAlertas + ' alerta' + (totalAlertas !== 1 ? 's' : '') + ' ativo' + (totalAlertas !== 1 ? 's' : '') + '</div>' +
      '</div>';
    });
    document.getElementById('healthCards').innerHTML = html;
  }

  // ═══════════════════════════════════════════════════════════
  // TOP 10
  // ═══════════════════════════════════════════════════════════

  function renderTop10(todosAlertas) {
    // Ordenar por prioridade e pegar os 10 primeiros
    var sorted = todosAlertas.slice().sort(function(a, b) {
      if (a.prioridade !== b.prioridade) return a.prioridade - b.prioridade;
      // Dentro da mesma prioridade, mais antigo primeiro
      var da = a.data ? new Date(a.data).getTime() : 0;
      var db = b.data ? new Date(b.data).getTime() : 0;
      return da - db;
    });
    var top = sorted.slice(0, 10);

    if (top.length === 0) {
      document.getElementById('top10List').innerHTML =
        '<div class="empty-state">' +
        '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' +
        '<h3>Tudo limpo!</h3><p>Nenhum alerta pendente. Bom trabalho.</p></div>';
      return;
    }

    var html = '';
    top.forEach(function(item, i) {
      var pClass = 'p' + item.prioridade;
      html += '<div class="top10-item">' +
        '<div class="top10-rank ' + pClass + '">' + (i + 1) + '</div>' +
        '<div class="top10-text">' +
          '<div class="top10-text-main">' + esc(item.texto) + '</div>' +
          '<div class="top10-text-detail">' + esc(item.detalhe) + ' ' + contaTag(item.conta_id) + '</div>' +
        '</div>' +
        (item.data ? '<div class="top10-days">' + diasAberto(item.data) + '</div>' : '') +
        '<div class="top10-actions">' +
          '<button class="alert-btn alert-btn-resolve" onclick="executarAcao(\'' + item.tipo + '\',\'' + esc(item.ref) + '\',\'resolvido\')" title="Resolvido">✓</button>' +
          '<button class="alert-btn alert-btn-snooze" onclick="mostrarSnooze(event,\'' + item.tipo + '\',\'' + esc(item.ref) + '\')" title="Adiar">⏰</button>' +
        '</div>' +
      '</div>';
    });
    document.getElementById('top10List').innerHTML = html;
  }

