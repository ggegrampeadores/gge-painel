  var alertasCarregados = {};  // tipo -> [items]
  var alertasAcoes = [];       // ações do operador (snooze/desliga/resolvido)
  var _skuCache = null;        // cache dos dados de skus_custo

  // Carrega skus_custo uma vez por refresh e cacheia
  async function carregarSkusCadastro() {
    if (_skuCache) return _skuCache;
    var { data } = await sb.from('skus_custo')
      .select('sku, descricao, peso, ncm, custo_cif_rj, custo_cif_sp, ean_principal, largura, altura, comprimento');
    _skuCache = {};
    (data || []).forEach(function(s) { _skuCache[s.sku] = s; });
    return _skuCache;
  }

  // ═══════════════════════════════════════════════════════════
  // FUNÇÕES DE RENDERIZAÇÃO
  // ═══════════════════════════════════════════════════════════

  function contaTag(contaId) {
    var c = CONTAS_MAP[contaId];
    if (!c) return '';
    var cls = 'gge';
    if (c.nome.includes('TOOW')) cls = 'toow';
    else if (c.nome.includes('GGESP')) cls = 'ggesp';
    return '<span class="conta-tag ' + cls + '">' + c.nome.replace('COMERCIAL','').replace('-GRAMPEADORES','') + '</span>';
  }

  function diasAberto(data) {
    if (!data) return '';
    var d = Math.floor((Date.now() - new Date(data).getTime()) / 86400000);
    if (d <= 0) return 'hoje';
    return d + 'd';
  }

  async function carregarContas() {
    var { data } = await sb.from('contas').select('id, nome, ml_user_id');
    (data || []).forEach(function(c) { CONTAS_MAP[c.id] = c; });
  }

  async function carregarAcoes() {
    var { data } = await sb.from('alertas_operador').select('*');
    alertasAcoes = data || [];
  }

  function alertaAtivo(tipo, ref) {
    // Verificar se existe ação que desativa este alerta
    for (var i = 0; i < alertasAcoes.length; i++) {
      var a = alertasAcoes[i];
      if (a.tipo_alerta !== tipo) continue;
      if (a.referencia && ref && a.referencia !== ref) continue;
      if (!a.referencia && ref) continue;
      if (a.acao === 'desligado' || a.acao === 'resolvido') return false;
      if (a.acao === 'snooze' && a.snooze_ate) {
        if (new Date(a.snooze_ate) > new Date()) return false;
      }
    }
    return true;
  }

  function filtrarAtivos(tipo, items) {
    return items.filter(function(item) { return alertaAtivo(tipo, item.ref); });
  }

  async function executarAcao(tipo, ref, acao, snoozeDias) {
    var registro = {
      tipo_alerta: tipo,
      referencia: ref || null,
      acao: acao
    };
    if (acao === 'snooze' && snoozeDias) {
      var dt = new Date();
      dt.setDate(dt.getDate() + snoozeDias);
      registro.snooze_ate = dt.toISOString().slice(0, 10);
    }
    await sb.from('alertas_operador').insert(registro);
    await carregarAcoes();
    carregarTudo();
  }

